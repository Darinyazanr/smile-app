{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-15-xcode-26.3"
      },
      "env": {
        "NPM_CLI_OPTIONS": "--legacy-peer-deps"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
"appleId": "15201127138@163.com",
        "ascAppId": "6786272727",
        "appleTeamId": "L6RHMYSR29"
      }
    }
  }
}
